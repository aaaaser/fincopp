{
  "name": "fincop",
  "private": true,
  "version": "0.1.0",
  "description": "FINCOP (Finansial Ucopp) — Aplikasi Pengelolaan Keuangan Pribadi Lokal",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "concurrently -k \"tsx server.ts\" \"wait-on http://127.0.0.1:3000 && npx tsc -p electron/tsconfig.json && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && npx tsc -p electron/tsconfig.json",
    "build:win": "npm run build:electron && electron-builder --win",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/check-db.ts",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
