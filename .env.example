# FINCOP (Finansial Ucopp) — Konfigurasi Lingkungan Lokal
# Salin file ini menjadi .env lalu sesuaikan kredensial MySQL lokal Anda.

# Koneksi MySQL 8 (Wajib untuk Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password_mysql_anda@127.0.0.1:3306/fincop_db"

# Konfigurasi Server Express Lokal
PORT=3000
NODE_ENV="development"

# URL Aplikasi Lokal
APP_URL="http://127.0.0.1:3000"

# GEMINI_API_KEY (Opsional, otomatis diinjeksi bila dijalankan di AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

